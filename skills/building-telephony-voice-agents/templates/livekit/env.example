# Environment for agent_gemini_live.py. Locally: copy to .env.local and export it.
# On LiveKit Cloud these become agent secrets (lk agent create/update-secrets --secrets-file).
# LIVEKIT_URL / LIVEKIT_API_KEY / LIVEKIT_API_SECRET are injected by Cloud; set them only for local runs.
# Comments are on their own lines on purpose: not every secrets-file parser strips inline comments.

LIVEKIT_URL=wss://<project-subdomain>.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxx

# Must equal room_config.agents[].agent_name in the dispatch rule
AGENT_NAME=my-agent

# --- Gemini Live on Vertex AI ---
GOOGLE_CLOUD_PROJECT=<gcp-project-id>
# Auto-discovered when mounted with --secret-mount; set explicitly elsewhere
# GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/gcp-sa.json
GEMINI_LIVE_MODEL=gemini-3.8-live
# us | eu | us-central1 are the only Vertex locations serving 3.8 Live
GEMINI_LIVE_LOCATION=us
GEMINI_LIVE_FALLBACK_LOCATION=us-central1
# A prebuilt Live voice; Gacrux was calmest in blind tests (references/03 §10.4). Re-test for your callers
GEMINI_LIVE_VOICE=Gacrux
# Off by default: it does not force the output language and pushed some Hindi callers to English
# GEMINI_LIVE_LANGUAGE=en-IN
TRANSCRIPTION_LANGUAGES=en-IN,hi-IN
# Phrases a recogniser would mangle, never bare brand words
# CUSTOM_VOCABULARY=<brand phrase one>,<brand phrase two>

# --- Conversation ---
GREETING_TEXT=Hello, thank you for calling. How can I help you today?
# SYSTEM_PROMPT_FILE=/app/prompt.md
BUSINESS_TIMEZONE=Asia/Kolkata
CLOSE_GRACE_SECONDS=4
SILENCE_CHECK_IN_SECONDS=20
SILENCE_FINAL_WARNING_SECONDS=40
SILENCE_CLOSE_SECONDS=60
MAX_CALL_SECONDS=900

# --- Audio ---
# bvc_telephony (LiveKit Cloud rooms only) or none (self-hosted)
NOISE_CANCELLATION=bvc_telephony
# BACKGROUND_AMBIENCE=OFFICE_AMBIENCE
# Keep ambience subtle on PSTN (0.1-0.2): G.711 turns loud beds into hiss
# BACKGROUND_AMBIENCE_VOLUME=0.15
# THINKING_SOUND=1

# --- Telephony ---
# Enables the transfer_to_human tool; the carrier must allow SIP REFER
# TRANSFER_TO=+91XXXXXXXXXX
# Needed for outbound dispatches with metadata {"phone_number": "+91..."}
# SIP_OUTBOUND_TRUNK_ID=ST_xxxxxxxx

# --- Recording and post-call (decide recording governance first) ---
RECORD_SESSION=0
# RECORDING_GCS_BUCKET=my-call-recordings
# POST_CALL_WEBHOOK_URL=https://backend.example.com/calls
# POST_CALL_DIR=/tmp/post-call
LOG_LEVEL=INFO
